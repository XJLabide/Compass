rules_version = '2';

// Personal Tracker Firestore Security Rules
//
// Model:
//   - Default-deny at root.
//   - All app data lives under `users/{uid}/...`.
//   - Access requires `request.auth.uid == uid`.
//   - Per-collection write validators enforce field shapes (numeric ranges,
//     required fields). See `docs/FIRESTORE_RULES.md` for deploy + edit notes.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid;
    }

    // -------------------------------------------------------------------
    // Field validators
    // -------------------------------------------------------------------
    function isNumOpt(data, field, lo, hi) {
      // Field is either absent or a number in [lo, hi].
      return !(field in data)
        || (data[field] is number && data[field] >= lo && data[field] <= hi);
    }

    function isIntOpt(data, field, lo, hi) {
      return !(field in data)
        || (data[field] is int && data[field] >= lo && data[field] <= hi);
    }

    function dailyValid(data) {
      // Optional numeric fields with sane ranges.
      // bodyweightKg must be strictly > 0 if present (use small epsilon).
      return (!('bodyweightKg' in data)
              || (data.bodyweightKg is number && data.bodyweightKg > 0 && data.bodyweightKg < 1000))
        && isNumOpt(data, 'sleepHours', 0, 24)
        && isIntOpt(data, 'sleepQuality', 1, 5)
        && isIntOpt(data, 'calories', 0, 100000)
        && isNumOpt(data, 'proteinG', 0, 100000)
        && isNumOpt(data, 'waterMl', 0, 100000)
        && isNumOpt(data, 'carbsG', 0, 100000)
        && isNumOpt(data, 'fatG', 0, 100000)
        && isIntOpt(data, 'steps', 0, 1000000)
        && isIntOpt(data, 'mood', 1, 5)
        && (!('note' in data) || data.note is string)
        && (!('struggles' in data) || (data.struggles is string && data.struggles.size() <= 5000))
        && (!('wins' in data) || (data.wins is string && data.wins.size() <= 5000))
        && (!('planTomorrow' in data) || (data.planTomorrow is string && data.planTomorrow.size() <= 5000))
        && (!('loggedMeals' in data) || data.loggedMeals is list)
        && data.localDate is string;
    }

    function sessionValid(data) {
      // sets must be a list; per-set validation handled at write time on client.
      // We at least require it to be a list and the metadata to be well-shaped.
      return data.localDate is string
        && data.name is string
        && data.sets is list
        && (!('plannedExercises' in data) || data.plannedExercises is list)
        && (!('durationMin' in data)
            || (data.durationMin is number && data.durationMin >= 0 && data.durationMin <= 1440))
        && (!('notes' in data) || data.notes is string)
        && (!('activityType' in data) || data.activityType in ['weight_lifting', 'running', 'sports'])
        && (!('distanceKm' in data) || (data.distanceKm is number && data.distanceKm >= 0))
        && (!('paceMinPerKm' in data) || (data.paceMinPerKm is number && data.paceMinPerKm >= 0))
        && (!('runType' in data) || data.runType in ['easy', 'tempo', 'intervals', 'long_run', 'general'])
        && (!('sportName' in data) || data.sportName is string)
        && (!('gameType' in data) || data.gameType in ['casual', 'match'])
        && (!('matchOutcome' in data) || data.matchOutcome in ['win', 'loss', 'draw', 'none'])
        && (!('score' in data) || data.score is string)
        && (!('opponent' in data) || data.opponent is string)
        && (!('intensity' in data) || data.intensity in ['low', 'moderate', 'high'])
        && (!('caloriesBurned' in data) || (data.caloriesBurned is number && data.caloriesBurned >= 0));
    }



    function prValid(data) {
      return data.exerciseId is string
        && data.exerciseName is string
        && data.weightKg is number && data.weightKg >= 0
        && data.reps is int && data.reps >= 0
        && data.e1RMKg is number && data.e1RMKg >= 0
        && data.sessionId is string
        && data.localDate is string;
    }

    function profileValid(data) {
      return data.displayName is string
        && data.unitSystem in ['imperial', 'metric']
        && data.proteinTargetG is number && data.proteinTargetG >= 0
        && data.weeklyGainLb is number
        && data.timezone is string
        && (!('currency' in data) || (data.currency is string && data.currency.size() == 3))
        && (!('budgets' in data) || data.budgets is map)
        && (!('customCategories' in data) || (data.customCategories is list && data.customCategories.size() <= 50))
        && (!('onboarded' in data) || data.onboarded is bool)
        && (!('notificationsEnabled' in data) || data.notificationsEnabled is bool)
        && (!('reminderTime' in data) || data.reminderTime is string)
        && (!('wakeTime' in data) || data.wakeTime is string)
        && (!('bedTime' in data) || data.bedTime is string)
        && (!('activeDayDate' in data) || data.activeDayDate is string)
        && (!('routineTimeBlocks' in data) || (data.routineTimeBlocks is list && data.routineTimeBlocks.size() <= 20))
        && isIntOpt(data, 'calorieTargetKcal', 0, 100000)
        && isIntOpt(data, 'carbTargetG', 0, 100000)
        && isIntOpt(data, 'fatTargetG', 0, 100000)
        && (!('favoriteFoods' in data) || data.favoriteFoods is list);
    }

    function exerciseValid(data) {
      return data.name is string
        && data.primaryMuscle is string
        && data.category is string
        && (!('gifUrl' in data) || data.gifUrl is string)
        && (!('instructions' in data) || data.instructions is list)
        && (!('equipments' in data) || data.equipments is list)
        && (!('secondaryMuscles' in data) || data.secondaryMuscles is list)
        && (!('aliases' in data) || data.aliases is list)
        && (!('archived' in data) || data.archived is bool)
        && (!('source' in data) || data.source in ['master', 'api', 'custom'])
        && (!('apiId' in data) || data.apiId is string);
    }

    function programValid(data) {
      return data.name is string
        && data.sessions is list
        && (!('schedule' in data) || data.schedule is map);
    }

    function todoValid(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 500
        && data.done is bool
        && (!('note' in data) || (data.note is string && data.note.size() <= 5000))
        && (!('priority' in data) || data.priority in ['low', 'medium', 'high'])
        && (!('dueDate' in data) || data.dueDate is string)
        && (!('recurrence' in data) || data.recurrence in ['none', 'daily', 'weekly'])
        && (!('projectId' in data) || data.projectId is string)
        && (!('projectColumnId' in data) || data.projectColumnId is string)
        && (!('projectOrder' in data) || data.projectOrder is number)
        && (!('projectCompletedColumnId' in data) || data.projectCompletedColumnId is string);
    }

    function projectValid(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 160
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('repositoryUrl' in data) || (data.repositoryUrl is string && data.repositoryUrl.size() <= 500))
        && (!('techStack' in data) || (data.techStack is list && data.techStack.size() <= 24))
        && data.columns is list
        && data.columns.size() > 0
        && data.columns.size() <= 12
        && data.archived is bool;
    }

    function expenseValid(data) {
      return data.amountMinor is int && data.amountMinor >= 0 && data.amountMinor <= 100000000
        && data.currency is string && data.currency.size() == 3
        && data.kind in ['expense', 'income']
        && data.category is string
        && data.localDate is string
        && (!('note' in data) || (data.note is string && data.note.size() <= 1000));
    }

    function recurringFeeValid(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.amountMinor is int && data.amountMinor > 0 && data.amountMinor <= 100000000
        && data.currency is string && data.currency.size() == 3
        && data.category is string
        && data.cadence in ['weekly', 'monthly', 'yearly']
        && data.active is bool
        && (!('billingDay' in data) || (data.billingDay is int && data.billingDay >= 1 && data.billingDay <= 31))
        && (!('billingMonthDay' in data) || data.billingMonthDay is string)
        && (!('nextDueDate' in data) || data.nextDueDate is string)
        && (!('note' in data) || (data.note is string && data.note.size() <= 1000));
    }

    function budgetValid(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.mode in ['allowance', 'monthly']
        && data.amountMinor is int && data.amountMinor >= 0 && data.amountMinor <= 100000000
        && data.currency is string && data.currency.size() == 3
        && data.startDate is string
        && data.endDate is string
        && data.active is bool;
    }

    function goalMetricValid(metric) {
      return metric is map
        && metric.id is string
        && metric.label is string
        && metric.source in [
          'manual',
          'bodyweight',
          'workouts_per_week',
          'calories_avg',
          'protein_avg',
          'steps_avg',
          'sleep_avg',
          'routine_completion',
          'budget_spend'
        ]
        && metric.direction in ['at_least', 'at_most', 'reach']
        && metric.target is number
        && (!('unit' in metric) || metric.unit is string);
    }

    function goalValid(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.area in ['fitness', 'nutrition', 'habits', 'money', 'personal']
        && data.state in ['active', 'later', 'completed']
        && data.status in ['on_track', 'ahead', 'behind', 'off_track', 'needs_data', 'blocked', 'done']
        && data.priorityRank is int && data.priorityRank >= 0 && data.priorityRank <= 100
        && (!('deadlineLocalDate' in data) || data.deadlineLocalDate is string)
        && (!('note' in data) || (data.note is string && data.note.size() <= 2000))
        && (!('primaryMetric' in data) || goalMetricValid(data.primaryMetric))
        && data.supportingMetrics is list && data.supportingMetrics.size() <= 12
        && data.milestones is list && data.milestones.size() <= 50;
    }

    function calendarTitleValid(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.active is bool
        && (!('location' in data) || (data.location is string && data.location.size() <= 300));
    }

    function calendarExternalValid(data) {
      return (!('externalSource' in data) || data.externalSource == 'google_calendar')
        && (!('externalCalendarId' in data) || data.externalCalendarId is string)
        && (!('externalEventId' in data) || data.externalEventId is string)
        && (!('externalInstanceId' in data) || data.externalInstanceId is string)
        && (!('externalUrl' in data) || data.externalUrl is string)
        && (!('externalUpdatedAt' in data) || data.externalUpdatedAt is string)
        && (!('externalSyncedAt' in data) || data.externalSyncedAt is timestamp);
    }

    function calendarClassValid(data) {
      return calendarTitleValid(data)
        && calendarExternalValid(data)
        && data.type == 'class'
        && data.weekdays is list
        && data.weekdays.size() >= 1
        && data.weekdays.size() <= 7
        && data.startTime is string
        && data.endTime is string
        && (!('startDate' in data) || data.startDate is string)
        && (!('endDate' in data) || data.endDate is string);
    }

    function calendarEventValid(data) {
      return calendarTitleValid(data)
        && calendarExternalValid(data)
        && data.type == 'event'
        && data.recurrence in ['none', 'weekly']
        && (!('startTime' in data) || data.startTime is string)
        && (!('endTime' in data) || data.endTime is string)
        && (
          (data.recurrence == 'none' && data.date is string)
          || (
            data.recurrence == 'weekly'
            && data.weekdays is list
            && data.weekdays.size() >= 1
            && data.weekdays.size() <= 7
          )
        );
    }

    function calendarItemValid(data) {
      return calendarClassValid(data) || calendarEventValid(data);
    }

    function routineValid(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.weekdays is list && data.weekdays.size() >= 1 && data.weekdays.size() <= 7
        && data.active is bool
        && (!('done' in data) || data.done is map)
        && (!('timeBlock' in data) || (data.timeBlock is string && data.timeBlock.size() <= 50))
        && (!('order' in data) || (data.order is int && data.order >= 0 && data.order <= 100));
    }

    function googleCalendarIntegrationValid(data) {
      return data.provider == 'google_calendar'
        && data.status in ['connected', 'disconnected', 'error']
        && data.selectedCalendarIds is list
        && data.selectedCalendarIds.size() <= 50
        && data.syncWindowPastDays is int
        && data.syncWindowFutureDays is int
        && (!('accountEmail' in data) || data.accountEmail is string)
        && (!('accountName' in data) || data.accountName is string)
        && (!('lastSyncAt' in data) || data.lastSyncAt is timestamp)
        && (!('lastSyncError' in data) || data.lastSyncError is string);
    }

    // -------------------------------------------------------------------
    // /users/{uid} — root for all user-owned data.
    // -------------------------------------------------------------------
    match /users/{uid} {
      // No top-level user doc reads/writes (we use subcollections only).
      allow read, write: if false;

      match /profile/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && profileValid(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /program/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && programValid(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /exercises/{exerciseId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && exerciseValid(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && sessionValid(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /daily/{dateId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && dailyValid(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /prs/{prId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && prValid(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /todos/{todoId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && todoValid(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /projects/{projectId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && projectValid(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /expenses/{expenseId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && expenseValid(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /goals/{goalId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && goalValid(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /calendarItems/{itemId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && calendarItemValid(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /integrations/{providerId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /budgets/{budgetId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && budgetValid(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /recurringFees/{feeId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && recurringFeeValid(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /routines/{routineId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && routineValid(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /portfolio/{holdingId} {
        allow read, write: if isOwner(uid);
      }

      match /accounts/{accountId} {
        allow read, write: if isOwner(uid);
      }

      // Nori (AI assistant) chat threads + messages.
      // Threads: users/{uid}/noriThreads/{threadId}
      // Messages: .../noriThreads/{threadId}/messages/{messageId}
      match /noriThreads/{threadId} {
        allow read, write: if isOwner(uid);
        match /messages/{messageId} {
          allow read, write: if isOwner(uid);
        }
      }
    }

    match /integrationSecrets/{secretId} {
      allow read, write: if false;
    }

    match /oauthStates/{stateId} {
      allow read, write: if false;
    }
  }
}
